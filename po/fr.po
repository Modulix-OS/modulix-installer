msgstr "Confirmer le mot de passe"

msgid "For a strong password, use one of (CNIL recommendation):\n - 12+ characters with uppercase, lowercase, digits and special characters\n - 14+ characters with uppercase, lowercase and digits\n - Passphrase of at least 7 words.\nOptional, but recommended."
msgstr "Pour un mot de passe robuste, utilisez l'une de ces options (recommandation de la CNIL) :\n - 12 caractères minimum avec majuscules, minuscules, chiffres et caractères spéciaux.\n - 14 caractères minimum avec majuscules, minuscules et chiffres.\n - Une phrase de passe d'au moins 7 mots.\nFacultatif, mais recommandé."

msgid "Passwords do not match."
msgstr "Les mots de passe ne correspondent pas."

msgid "User"
msgstr "Utilisateur"

msgid "Enter a username"
msgstr "Saisissez un nom d'utilisateur"

msgid "Passwords must match and not be empty"
msgstr "Les mots de passe doivent correspondre et ne pas être vides"

