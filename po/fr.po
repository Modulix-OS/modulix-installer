msgstr "Nouvelle partition"

msgid "Next"
msgstr "Suivant"

msgid "No TPM2 chip detected"
msgstr "Aucune puce TPM2 détectée"

msgid "No Wi-Fi networks found"
msgstr "Aucun réseau Wi-Fi trouvé"

msgid "No Windows installation was found on this disk"
msgstr "Aucune installation Windows n'a été trouvée sur ce disque"

msgid "No applications"
msgstr "Aucune application"

msgid "No disk selected"
msgstr "Aucun disque sélectionné"

msgid "No existing partitions will be deleted."
msgstr "Aucune partition existante ne sera supprimée."

msgid "No filesystem"
msgstr "Aucun système de fichiers"

msgid "No partitions"
msgstr "Aucune partition"

msgid "No swap"
msgstr "Pas d'espace d'échange"

msgid "Not connected"
msgstr "Non connecté"

msgid "Not enough space would be freed up to install Modulix OS"
msgstr "L'espace libéré serait insuffisant pour installer Modulix OS"

msgid "Office suite"
msgstr "Suite bureautique"

msgid "Once this finishes, you'll be ready to restart into your new system."
msgstr "Une fois terminé, vous pourrez redémarrer sur votre nouveau système."

msgid "Only one partition can be assigned as root (/)"
msgstr "Une seule partition peut être attribuée à la racine (/)"

msgid "Only one partition can be assigned to /boot, /home, or swap"
msgstr "Une seule partition peut être assignée à /boot, /home ou au swap"

msgid "Open (no password)"
msgstr "Ouvert (sans mot de passe)"

msgid "Open network, signal {level} of 4"
msgstr "Réseau ouvert, signal {level} sur 4"

