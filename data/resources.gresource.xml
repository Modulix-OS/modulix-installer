        >apps/org.gnome.Nautilus.svg</file>
    <file alias="modulix-app-pack-papers.svg">apps/org.gnome.Papers.svg</file>
    <file alias="modulix-app-pack-printer.svg">devices/printer.svg</file>
  </gresource>
