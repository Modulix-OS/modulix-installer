  <!-- App-pack card icons, resolved straight out of the `papirus-icon-theme`
       nixpkgs derivation (GPL-3.0) via the extra --sourcedir build.rs adds
       from $PAPIRUS_ICON_THEME_48 — not vendored into this repo. Paths below
       are relative to that theme's 48x48/ directory. Filed under
       icons/scalable/apps so `IconTheme::lookup_icon` (already registered on
       "/org/modulix/installer/icons" in src/main.rs) re-rasterizes them at
       whatever pixel size is requested instead of stretching a fixed-size
       bitmap — see `icon_widget_for` in src/steps/app_pack/mod.rs. -->
  <gresource prefix="/org/modulix/installer/icons/scalable/apps">
    <file alias="modulix-app-pack-store.svg">apps/org.gnome.Software.svg</file>
    <file alias="modulix-app-pack-firefox.svg">apps/firefox.svg</file>
