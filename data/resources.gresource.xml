<?xml version="1.0" encoding="UTF-8" ?>
<gresources>
  <gresource prefix="/org/modulix/installer/icons/scalable/actions">
    <!-- Every other step/rail icon comes from adwaita-icon-theme (carried by
         nix/package.nix's XDG_DATA_DIRS); this one does not exist there. -->
    <file alias="qr-code-symbolic.svg">icons/qr-code-symbolic.svg</file>
    <!-- GNOME Settings' own accessibility glyph, copied verbatim from
         gnome-control-center (GPL-2.0-or-later), where it is
         `org.gnome.Settings-accessibility-symbolic`. adwaita-icon-theme only
         carries the older `preferences-desktop-accessibility`, and pulling this
         one from the store at build time the way the Papirus icons below are
         would make gnome-control-center — a 1.8 GiB closure — a build
         dependency of the installer for a single 1 KiB file. -->
    <file
            alias="accessibility-symbolic.svg"
        >icons/accessibility-symbolic.svg</file>
  </gresource>
  <!-- App-pack card icons, resolved straight out of the `papirus-icon-theme`
       nixpkgs derivation (GPL-3.0) via the extra --sourcedir build.rs adds
       from $PAPIRUS_ICON_THEME_48 — not vendored into this repo. Paths below
       are relative to that theme's 48x48/ directory. Filed under
       icons/scalable/apps so `IconTheme::lookup_icon` (already registered on
       "/org/modulix/installer/icons" in src/main.rs) re-rasterizes them at
       whatever pixel size is requested instead of stretching a fixed-size
       bitmap — see `icon_widget_for` in src/steps/app_pack/mod.rs. -->
  <gresource prefix="/org/modulix/installer/icons/scalable/apps">
    <file alias="modulix-app-pack-firefox.svg">apps/firefox.svg</file>
    <file
            alias="modulix-app-pack-nautilus.svg"
        >apps/org.gnome.Nautilus.svg</file>
    <file alias="modulix-app-pack-thunderbird.svg">apps/thunderbird.svg</file>
    <file alias="modulix-app-pack-steam.svg">apps/steam.svg</file>
    <file alias="modulix-app-pack-lutris.svg">apps/lutris.svg</file>
    <file alias="modulix-app-pack-heroic.svg">apps/heroic.svg</file>
    <file alias="modulix-app-pack-kdenlive.svg">apps/kdenlive.svg</file>
    <file alias="modulix-app-pack-davinci-resolve.svg">apps/resolve.svg</file>
    <file alias="modulix-app-pack-obs.svg">apps/obs.svg</file>
    <file alias="modulix-app-pack-krita.svg">apps/krita.svg</file>
    <file alias="modulix-app-pack-gimp.svg">apps/gimp.svg</file>
    <file alias="modulix-app-pack-blender.svg">apps/blender.svg</file>
    <file alias="modulix-app-pack-papers.svg">apps/org.gnome.Papers.svg</file>
    <file alias="modulix-app-pack-inkscape.svg">apps/inkscape.svg</file>
    <file alias="modulix-app-pack-ue5.svg">apps/ue4editor.svg</file>
    <file alias="modulix-app-pack-vscode.svg">apps/vscode.svg</file>
    <file alias="modulix-app-pack-git.svg">apps/git.svg</file>
    <file
            alias="modulix-app-pack-ubuntu.svg"
        >apps/distributor-logo-ubuntu.svg</file>
    <file alias="modulix-app-pack-gamepad.svg">devices/input-gaming.svg</file>
    <file alias="modulix-app-pack-printer.svg">devices/printer.svg</file>
  </gresource>
  <gresource prefix="/org/modulix/installer/images">
    <file alias="earth.jpg">images/earth.jpg</file>
  </gresource>
  <gresource prefix="/org/modulix/installer/images/screenshots">
    <file alias="gnome1.jpg">screenshots/gnome1.jpg</file>
    <file alias="gnome2.jpg">screenshots/gnome2.jpg</file>
    <file alias="gnome3.jpg">screenshots/gnome3.jpg</file>
    <file alias="plasma.svg">screenshots/plasma.svg</file>
    <file alias="xfce.svg">screenshots/xfce.svg</file>
    <file alias="lxqt.svg">screenshots/lxqt.svg</file>
  </gresource>
  <gresource prefix="/org/modulix/installer/images/slides">
    <file alias="slide-1.svg">slides/slide-1.svg</file>
    <file alias="slide-2.svg">slides/slide-2.svg</file>
    <file alias="slide-3.svg">slides/slide-3.svg</file>
    <file alias="slide-4.svg">slides/slide-4.svg</file>
  </gresource>
</gresources>
